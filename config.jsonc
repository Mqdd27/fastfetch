{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "data",
    "source": "$1    /\\_____/\\\n   /  o   o  \\\n  ( ==  ^  == )\n   )         (\n  (           )\n ( (  )   (  ) )\n(__(__)___(__)__)",
    "color": { "1": "yellow" },
    "padding": { "top": 2, "right": 3 }
  },
  "display": { "separator": "  " },
  "modules": [
    "title",
    { "type": "os", "key": "os" },
    { "type": "host", "key": "host" },
    { "type": "uptime", "key": "up" },
    { "type": "shell", "key": "sh" },
    { "type": "terminal", "key": "term" },
    { "type": "cpu", "key": "cpu" },
    { "type": "memory", "key": "mem" },
    { "type": "disk", "key": "disk", "folders": "/" },
    "colors"
  ]
}
